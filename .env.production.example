# Copy to a deployment-owned secret store or environment; never commit a populated file.
# Production requires signed Bearer JWTs. Values belong in deployment configuration,
# and are not credentials or private signing keys.
DRIVEGUARD_HMI_BIND_ADDRESS=127.0.0.1
DRIVEGUARD_HMI_PORT=8080
DRIVEGUARD_AUTH_MODE=jwt
DRIVEGUARD_AUTH_ISSUER=https://issuer.example.invalid/
DRIVEGUARD_AUTH_AUDIENCE=driveguard-api
DRIVEGUARD_AUTH_JWKS_URL=https://issuer.example.invalid/.well-known/jwks.json
DRIVEGUARD_AUTH_ALLOWED_ALGORITHMS=RS256
DRIVEGUARD_AUTH_VEHICLE_CLAIM=authorized_vehicle_ids
DRIVEGUARD_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace-with-deployment-secret
POSTGRES_USER=driveguard
POSTGRES_PASSWORD=replace-with-deployment-secret
POSTGRES_APP_USER=driveguard_app
POSTGRES_APP_PASSWORD=replace-with-deployment-secret
POSTGRES_DB=driveguard
URGENT_CONFIRMATION_SECRET=replace-with-at-least-32-random-characters
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-deployment-secret
DRIVEGUARD_IMAGE_TAG=replace-with-full-40-character-git-sha
