# DriveGuard release configuration. Copy this file to .env and replace every REQUIRED value.
# REQUIRED only for live DeepSeek use; leave empty when DRIVEGUARD_LLM_PROVIDER=faux.
DEEPSEEK_API_KEY=
# OPTIONAL: selected only when DRIVEGUARD_LLM_PROVIDER=deepseek.
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# REQUIRED for release: use the immutable Git SHA, never only "latest".
DRIVEGUARD_IMAGE_TAG=replace-with-git-sha
# DEVELOPMENT-ONLY: faux avoids external model credentials in local and CI runs.
DRIVEGUARD_LLM_PROVIDER=faux
# DEVELOPMENT-ONLY. Production must use the appropriate non-development runtime mode.
PHASE_5_RUNTIME_MODE=read_only
PHASE_5_DEVELOPMENT_OPT_IN=

# OPTIONAL host-port bindings; services communicate on the internal Compose network.
DRIVEGUARD_API_PORT=3000
POSTGRES_USER=driveguard
POSTGRES_PASSWORD=example-local-password
POSTGRES_APP_USER=driveguard_app
POSTGRES_APP_PASSWORD=example-runtime-password
POSTGRES_DB=driveguard
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379
REDIS_PORT=6379
NATS_URL=nats://nats:4222
PG_POOL_MAX=20
PG_CONNECTION_TIMEOUT_MS=1500
PG_IDLE_TIMEOUT_MS=30000
DRIVEGUARD_MAX_CONCURRENT_REQUESTS=32
DRIVEGUARD_MAX_REQUEST_QUEUE=64
DRIVEGUARD_REQUEST_QUEUE_TIMEOUT_MS=500
DRIVEGUARD_MAX_READ_EXECUTIONS=4
DRIVEGUARD_MAX_WRITE_EXECUTIONS=8
DRIVEGUARD_MAX_EXECUTOR_QUEUE=256
DRIVEGUARD_EXECUTOR_QUEUE_TIMEOUT_MS=5000
DRIVEGUARD_AGENT_TIMEOUT_MS=15000
DRIVEGUARD_SHUTDOWN_TIMEOUT_MS=30000
URGENT_EVENT_USER_ID=phase5-driver
# REQUIRED: provide a unique secret of at least 32 characters; never commit it.
URGENT_CONFIRMATION_SECRET=replace-with-at-least-32-random-characters
