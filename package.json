{
  "name": "driveguard",
  "version": "0.0.0",
  "private": true,
  "description": "Safety-aware driving service orchestration Agent Runtime",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json && tsc --project packages/shared/tsconfig.json && tsc --project packages/domain/tsconfig.json && tsc --project packages/context/tsconfig.json && tsc --project packages/capabilities/tsconfig.json && tsc --project packages/tools/tsconfig.json && tsc --project packages/policy/tsconfig.json && tsc --project packages/action-lifecycle/tsconfig.json && tsc --project packages/executor/tsconfig.json && tsc --project packages/memory/tsconfig.json && tsc --project packages/agent-runtime/tsconfig.json && tsc --project packages/urgent-events/tsconfig.json && tsc --project packages/persistence/tsconfig.json && tsc --project packages/observability/tsconfig.json && tsc --project services/vehicle-simulator/tsconfig.json",
    "db:migrate": "npm run build --silent && node dist/packages/persistence/src/migrate-cli.js",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint . --max-warnings=0",
    "start:api": "node dist/apps/api/src/server.js",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract --passWithNoTests",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:phase2": "vitest run tests/unit/phase2-vehicle.test.ts tests/unit/phase2-trip-context.test.ts tests/unit/phase2-snapshot.test.ts tests/unit/phase2-freshness.test.ts tests/unit/phase2-conflict.test.ts tests/contract/phase2-fixture-compatibility.test.ts",
    "test:phase2:coverage": "npm run test:phase2 -- --coverage --coverage.include=packages/domain/src/**/*.ts --coverage.include=packages/context/src/**/*.ts --coverage.reporter=text --coverage.reporter=json-summary --coverage.reporter=html",
    "test:phase2:packages": "npm run build --silent && node tests/contract/phase2-package-exports.mjs",
    "test:phase3": "vitest run tests/unit/phase3-*.test.ts tests/contract/phase3-*.test.ts tests/integration/phase3-*.test.ts",
    "test:phase3:coverage": "npm run test:phase3 -- --coverage --coverage.include=services/vehicle-simulator/src/**/*.ts --coverage.exclude=services/vehicle-simulator/src/server.ts --coverage.exclude=services/vehicle-simulator/src/index.ts --coverage.reporter=text --coverage.reporter=json-summary --coverage.reporter=html",
    "test:phase4": "vitest run tests/unit/phase4-*.test.ts tests/contract/phase4-*.test.ts tests/integration/phase4-*.test.ts",
    "test:phase4:coverage": "npm run test:phase4 -- --coverage --coverage.include=packages/capabilities/src/**/*.ts --coverage.include=packages/tools/src/**/*.ts --coverage.reporter=text --coverage.reporter=json-summary --coverage.reporter=html",
    "test:phase4:packages": "npm run build --silent && node tests/contract/phase4-package-exports.mjs",
    "test:phase5": "vitest run tests/unit/phase5-*.test.ts tests/contract/phase5-*.test.ts tests/integration/phase5-*.test.ts",
    "test:phase5:coverage": "npm run test:phase5 -- --coverage --coverage.include=packages/agent-runtime/src/agent-run.ts --coverage.include=packages/agent-runtime/src/context-loader.ts --coverage.include=packages/agent-runtime/src/pi-tool-adapter.ts --coverage.include=packages/agent-runtime/src/pi-event-adapter.ts --coverage.include=packages/agent-runtime/src/session.ts --coverage.include=packages/agent-runtime/src/production-runtime.ts --coverage.include=packages/agent-runtime/src/production-factory.ts --coverage.include=packages/agent-runtime/src/runtime-errors.ts --coverage.include=packages/agent-runtime/src/runtime-events.ts --coverage.reporter=text --coverage.reporter=json-summary --coverage.reporter=html",
    "test:phase5:packages": "npm run build --silent && node tests/contract/phase5-package-exports.mjs",
    "test:phase5:live": "npm run build --silent && node dist/packages/agent-runtime/src/phase5-live-smoke.js",
    "test:phase6": "vitest run tests/unit/phase6-*.test.ts tests/contract/phase6-*.test.ts tests/integration/phase6-*.test.ts",
    "test:phase6:coverage": "npm run test:phase6 -- --coverage --coverage.include=packages/policy/src/**/*.ts --coverage.exclude=packages/policy/src/index.ts --coverage.include=packages/agent-runtime/src/policy-guarded-tool-handler.ts --coverage.reporter=text --coverage.reporter=json-summary --coverage.reporter=html",
    "test:phase6:packages": "npm run build --silent && node tests/contract/phase6-package-exports.mjs",
    "test:phase6:live": "npm run build --silent && node dist/packages/agent-runtime/src/phase6-live-smoke.js",
    "test:phase7": "vitest run tests/unit/phase7-*.test.ts tests/contract/phase7-*.test.ts tests/integration/phase7-*.test.ts",
    "test:phase7:coverage": "vitest run tests/unit/phase7-*.test.ts tests/contract/phase7-*.test.ts tests/integration/phase7-*.test.ts tests/unit/phase5-*.test.ts tests/integration/phase5-*.test.ts tests/unit/phase6-policy-guard.test.ts tests/integration/phase6-runtime-policy.test.ts --coverage --coverage.include=packages/action-lifecycle/src/**/*.ts --coverage.exclude=packages/action-lifecycle/src/index.ts --coverage.include=packages/agent-runtime/src/policy-guarded-tool-handler.ts --coverage.include=packages/agent-runtime/src/production-runtime.ts --coverage.include=packages/agent-runtime/src/production-factory.ts --coverage.include=packages/agent-runtime/src/trusted-confirmation-channel.ts --coverage.reporter=text --coverage.reporter=json-summary --coverage.reporter=html --coverage.thresholds.lines=95 --coverage.thresholds.branches=95",
    "test:phase7:packages": "npm run build --silent && node tests/contract/phase7-package-exports.mjs",
    "test:phase7:live": "npm run build --silent && node dist/packages/agent-runtime/src/phase7-live-smoke.js",
    "test:phase8": "vitest run tests/unit/phase8-*.test.ts tests/contract/phase8-*.test.ts tests/integration/phase8-*.test.ts",
    "test:phase8:coverage": "npm run test:phase8 -- --coverage --coverage.include=packages/executor/src/**/*.ts --coverage.exclude=packages/executor/src/index.ts --coverage.reporter=text --coverage.reporter=json-summary --coverage.reporter=html --coverage.thresholds.lines=95 --coverage.thresholds.branches=95",
    "test:phase8:authorization-coverage": "vitest run tests/unit/phase8-authorization-consumption.test.ts --coverage --coverage.include=packages/action-lifecycle/src/authorization-consumption.ts --coverage.reporter=text --coverage.thresholds.lines=100 --coverage.thresholds.branches=100",
    "test:phase8:packages": "npm run build --silent && node tests/contract/phase8-package-exports.mjs",
    "test:phase9": "vitest run tests/unit/phase9-*.test.ts tests/contract/phase9-*.test.ts tests/integration/phase9-*.test.ts",
    "test:phase9:coverage": "npm run test:phase9 -- --coverage --coverage.include=packages/persistence/src/**/*.ts --coverage.include=packages/memory/src/**/*.ts --coverage.reporter=text --coverage.reporter=json-summary --coverage.reporter=html --coverage.thresholds.lines=90 --coverage.thresholds.branches=90",
    "test:phase9:packages": "npm run build --silent && node tests/contract/phase9-package-exports.mjs",
    "test:phase10": "vitest run tests/unit/health.test.ts tests/unit/phase10-*.test.ts tests/contract/phase10-*.test.ts tests/integration/phase10-*.test.ts",
    "test:phase10:coverage": "npm run test:phase10 -- --coverage --coverage.include=apps/api/src/app.ts --coverage.include=apps/api/src/errors.ts --coverage.include=apps/api/src/events.ts --coverage.include=apps/api/src/routes.ts --coverage.include=apps/api/src/service.ts --coverage.reporter=text --coverage.reporter=json-summary --coverage.reporter=html --coverage.thresholds.lines=90 --coverage.thresholds.branches=90",
    "test:phase10:docker": "node tests/smoke/phase10-docker-smoke.mjs",
    "test:phase11": "vitest run tests/unit/phase11-*.test.ts tests/contract/phase11-*.test.ts tests/integration/phase11-*.test.ts",
    "test:phase11:coverage": "npm run test:phase11 -- --coverage --coverage.include=packages/observability/src/**/*.ts --coverage.exclude=packages/observability/src/index.ts --coverage.reporter=text --coverage.reporter=json-summary --coverage.reporter=html --coverage.thresholds.lines=90 --coverage.thresholds.branches=70",
    "test:phase11:docker": "node tests/smoke/phase11-docker-smoke.mjs",
    "test:phase12": "vitest run tests/unit/phase12-*.test.ts tests/contract/phase12-*.test.ts tests/integration/phase12-*.test.ts",
    "test:phase12:coverage": "npm run test:phase12 -- --coverage --coverage.include=packages/urgent-events/src/**/*.ts --coverage.include=packages/persistence/src/urgent-event.ts --coverage.reporter=text --coverage.reporter=json-summary --coverage.reporter=html",
    "test:phase12:docker": "node tests/smoke/phase12-docker-smoke.mjs",
    "test:phase13": "vitest run tests/unit/phase13-*.test.ts tests/contract/phase13-*.test.ts tests/integration/phase13-*.test.ts",
    "eval:phase13:native": "npm run build --silent && node dist/evals/runner/cli.js --track native --mode deterministic",
    "eval:phase13:native:live": "npm run build --silent && node dist/evals/runner/cli.js --track native --mode live",
    "eval:phase13:native:write-dataset": "npm run build --silent && node dist/evals/runner/cli.js --track native --mode deterministic --write-dataset",
    "test:phase1:live": "npm run build --silent && node dist/packages/agent-runtime/src/live-smoke.js"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.3",
    "@earendil-works/pi-ai": "0.84.3",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "redis": "6.2.1",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
